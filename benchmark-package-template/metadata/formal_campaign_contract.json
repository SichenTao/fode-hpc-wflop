      "normalization": "explicit unit-preserving raw scale or REQUIRED_NORMALIZATION",
      "reference": "fixed scalar oracle/target or explicitly not applicable"
    },
    "multiobjective": {
      "metrics": ["hypervolume", "IGD+", "feasible nondominated count"],
      "normalization": "REQUIRED_PER_CASE_FROZEN_NORMALIZATION",
      "reference_front": "REQUIRED_PER_CASE_FROZEN_REFERENCE_FRONT",
      "hypervolume_reference_point": "REQUIRED_FROZEN_POINT"
    },
    "cross_case_pooling": false
  }
