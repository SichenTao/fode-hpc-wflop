    "compiler_flags": ["REQUIRED_FLAG"],
    "libraries": [{"name": "REQUIRED_LIBRARY", "path": "REQUIRED_PATH", "sha256": "REQUIRED_SHA256"}]
  },
  "binary": {
    "target": "benchmark_package_runner",
    "relative_build_path": "benchmark_package_runner",
    "sha256": "REQUIRED_SHA256"
  },
  "execution": {
    "backend": "cpu",
    "workers": "REQUIRED_POSITIVE_INTEGER",
    "processes_at_once": 1,
    "cpu_work_partition": "REQUIRED_SAFE_PARALLEL_STAGES",
    "gpu_used": false
  },
  "profile": {
    "profile_id": "REQUIRED_PROFILE_ID",
    "method_semantics_id": "REQUIRED_METHOD_SEMANTICS_ID",
    "problem_semantics_id": "REQUIRED_PROBLEM_SEMANTICS_ID",
    "method_evidence_tier": "REQUIRED_M0_TO_M4",
    "problem_evidence_tier": "REQUIRED_P0_TO_P4",
    "claim_boundary": "REQUIRED_EXACT_CLAIM_BOUNDARY"
  },
  "work": {
    "training_seed_namespace": "training/REQUIRED_PACKAGE_ID",
    "optimization_seed_namespace": "optimization/REQUIRED_PACKAGE_ID",
    "namespaces_disjoint": true,
    "training_physical_fes": "REQUIRED_INTEGER_OR_RUNTIME_LEDGER",
